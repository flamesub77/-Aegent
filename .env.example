# .env로 복사해서 사용하세요. .env는 커밋하지 않습니다.
# 실행 모드: ai(키가 있으면 AI, 없거나 실패하면 오프라인) | offline(외부 통신 없음, 회사 배포 권장)
APP_MODE=ai
# AI 모드 기본 제공자: openai | anthropic | gemini (화면 🔑에서 바꿀 수 있음)
AI_PROVIDER=openai
# 키는 화면 🔑에서 넣어도 됩니다 (메모리에만 보관). 여기 키는 ALLOW_SHARED_KEY=true일 때만 씀
ALLOW_SHARED_KEY=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# 추론 강도: low | medium | high (빈 값이면 전달 안 함)
OPENAI_REASONING_EFFORT=medium
# Claude (pip install anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gemini (pip install google-genai). 모델 이름은 배포 시 지정
GEMINI_API_KEY=
GEMINI_MODEL=
MAX_AGENT_TURNS=12
